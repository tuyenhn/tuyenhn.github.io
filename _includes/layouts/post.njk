---
layout: layouts/base.njk
isPost: true
---
{# blog post page; `isPost` makes the base layout open the post as a closable tab in the tab bar #}
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <time datetime="{{ page.date | isoDate }}">{{
      page.date | readableDate
    }}</time>
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
