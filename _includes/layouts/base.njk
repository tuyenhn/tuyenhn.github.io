<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <link
      href="/assets/styles.css"
      rel="stylesheet"
    />
    <title>{{ title }}</title>
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Yomogi&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="page">
      {# tab bar; each page sets `tab` in its front matter to mark the active tab #}
      {%
        set tabs = [
          {
            id: "about me",
            url: "/"
          }, {
            id: "blog",
            url: "/blog/"
          }
        ]
      %}
      <nav
        id="tab-bar"
        aria-label="Site sections">
        {% for t in tabs %}
          <a
            href="{{ t.url }}"
            class="tab"
            {% if t.id == tab %}aria-current="page"{% endif %}>{{ t.id }}</a>
        {% endfor %}
      </nav>
      <main id="innerBody">
        {{ content | safe }}
      </main>
    </div>
    {# scroll-to-top button; hidden until the page is scrolled down #}
    <button
      type="button"
      id="scroll-top-btn"
      aria-label="Scroll to top"
      title="Scroll to top">
      {% lucide "arrow-up" %}
    </button>
    <script>
    const scrollTopBtn = document.getElementById("scroll-top-btn");
      const toggleScrollTopBtn = () => {
        scrollTopBtn
          .classList
          .toggle("is-shown", window.scrollY > 400);
      };
      window.addEventListener("scroll", toggleScrollTopBtn, {passive: true});
      toggleScrollTopBtn();
      scrollTopBtn.addEventListener("click", () => {
        const reduceMotion = window
          .matchMedia("(prefers-reduced-motion: reduce)")
          .matches;
        window.scrollTo({
          top: 0,
          behavior: reduceMotion
            ? "auto"
            : "smooth"
        });
      });
    </script>
  </body>
</html>
