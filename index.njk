---
title: Tuyen Huynh personal website
layout: layouts/base.njk
tab: main
---
{# markdown text contents (with html tags) #}
{% renderFile "./_includes/content.njk" %}
{# `things` showcase section #}
<section>
  {# add all to tag set #}
  {% set allTags = ["all"].concat(collections.tagSet) %}
  <div id="tag-btn-list">
    {% for tag in allTags %}
      <button
        type="button"
        class="tag-btn"
        data-seltag="{{ tag }}">
        {% if tag == "all" %}
          {%
            tag "ALL",
            "gray"
          %}
        {% else %}
          {% tag tag %}
        {% endif %}
      </button>
    {% endfor %}
  </div>
  {# list of `things` #}
  <div id="thing-list">
    {% for thing in things | sort(true, true, 'date') %}
      <div
        class="thing-card"
        data-tags="{{ thing.tags.join(',') }}">
        {# tags #}
        <div id="thing-tags">
          {% for tag in thing.tags %}
            {% tag tag %}
          {% endfor %}
        </div>
        {# title #}
        <div id="title">
          {{ thing.title }}
        </div>
        {# roles #}
        <div class="block">
          <span class="thing-field">Role(s):</span>
          {% for role in thing.roles %}
            <span>{{ role | capitalize }}</span>
            {%- if not loop.last %};{% endif %}
          {% endfor %}
        </div>
        {# date #}
        <div class="block">
          <span class="thing-field">Date:</span>
          {{ thing.date }}
        </div>
        {# extra stuff #}
        {% for field in thing.extra %}
          <div>
            <span class="thing-field">{{ field.name }}:</span>
            {{ field.value }}
          </div>
        {% endfor %}
        {# url #}
        {% if thing.url %}
          <div class="block">
            <a
              href="{{ thing.url }}"
              class="thing-field"
              target="_blank">
              <span>
                {% if 'publication' in thing.tags %}
                  DOI
                {% else %}
                  Learn more
                {% endif %}
                {% lucide "external-link" %}
              </span>
            </a>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
{# script for tag buttons filtering #}
<script>
const buttons = document.querySelectorAll(".tag-btn");
  const things = document.querySelectorAll(".thing-card");
  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      const tag = btn.dataset.seltag;
      things.forEach(thing => {
        if (tag === "all") {
          thing.style.display = "grid";
        } else {
          thing.style.display = thing
            .dataset
            .tags
            .split(",")
            .includes(tag)
              ? "grid"
              : "none";
        }
      });
    });
  });
</script>
